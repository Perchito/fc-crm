DATABASE_URL=postgresql://fc_crm:PASSWORD@127.0.0.1:5432/fc_crm
PORT=4600
CRM_USER=fc
CRM_PASS=

# email steps (iCloud SMTP): ICLOUD_SMTP_USER / ICLOUD_SMTP_PASS / ICLOUD_FROM_NAME /
# ICLOUD_FROM_ADDRESS — on the homeserver these come from /etc/fc-outreach/outreach.env
# (the fc-outreach systemd unit loads it as a second EnvironmentFile), so they're not
# duplicated here. Set them below only for local dev.
ICLOUD_SMTP_USER=
ICLOUD_SMTP_PASS=

# sms steps (Twilio) — leave blank to keep sms steps off
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# worker/discover.mjs (run via systemd timer, needs `claude` CLI logged in)
# hospitality only, independent/family-owned only — see worker/discover.mjs
DISCOVER_AREA=Bolton, Greater Manchester
DISCOVER_COUNT=8
