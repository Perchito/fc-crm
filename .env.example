DATABASE_URL=postgresql://fc_crm:PASSWORD@127.0.0.1:5432/fc_crm
PORT=4600
CRM_USER=fc
CRM_PASS=

# email steps (iCloud SMTP) — leave blank to keep email steps off
ICLOUD_SMTP_USER=
ICLOUD_SMTP_PASS=
FROM_NAME=FC Cleaning Company
FROM_ADDRESS=

# sms steps (Twilio) — leave blank to keep sms steps off
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# worker/discover.mjs (run via systemd timer, needs `claude` CLI logged in)
DISCOVER_QUERY=
DISCOVER_COUNT=8
